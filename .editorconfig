root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_style = tab
indent_size = 2
tab_width = 2
ij_kotlin_continuation_indent_size = 4
ij_kotlin_code_style_defaults = KOTLIN_OFFICIAL

[*.{xml,yml,yaml,json}]
indent_style = space
indent_size = 4
